# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Node.js / Next.js
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Local databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ORVYN local user uploads
backend/storage/

# Local database backups
backend/backups/

# Local cache and generated files
.cache/
tmp/
temp/
